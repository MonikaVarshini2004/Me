# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Client URL for CORS (e.g., http://localhost:5173 for local, https://your-domain.com for production)
CLIENT_URL=http://localhost:5173

# Nodemailer / Gmail SMTP Configuration
# Use your Google Account email address
EMAIL_USER=your_email@gmail.com

# 16-character Google App Password (NOT your personal Gmail account password)
# Generated from Google Account -> Security -> 2-Step Verification -> App Passwords
EMAIL_PASS=your_16_character_app_password

# The destination email address where contact form submissions will be delivered
TO_EMAIL=your_inbox@gmail.com
